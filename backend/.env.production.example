# Plantilla, sin credenciales. Definir en el panel del servicio, no subir el .env real.
NODE_ENV=production
CORS_ORIGIN=https://FRONTEND.example
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/starthotel_db?retryWrites=true&w=majority
REQUIRE_LOCAL_DB=false
EXPECTED_DB_NAME=starthotel_db
# Railway proporciona PORT automáticamente. Para una prueba local:
# PORT=4000
# Activar solo detrás de un proxy inverso de confianza:
TRUST_PROXY=1
