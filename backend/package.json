{
  "name": "star-hotel-api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "setup:local": "tsx src/setup-local.ts",
    "db:local": "node scripts/db-mode.cjs local",
    "db:atlas": "node scripts/db-mode.cjs atlas",
    "db:check": "node scripts/check-db.cjs",
    "test": "tsx --test src/tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mongoose": "^8.19.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^20.19.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
